<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FootballWEB</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FootballWEB.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <a asp-controller="Home" asp-action="Index" class="logo">
            <img src="~/images/ankaraturnuva.png" alt="logo">
            </a>

            <nav class="navbar">
                <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                <a asp-controller="Matches" asp-action="Index">Maçlar</a>
                <a asp-controller="Teams" asp-action="Index">Takımlar</a>
                <a asp-controller="Players" asp-action="Index">Oyuncular</a>
                <a asp-controller="Standings" asp-action="Index">Puan Durumu</a>
            </nav>

            <button class="menu-btn" onclick="toggleMenu()">
                <span class="menu-icon"></span>
                <span class="menu-icon"></span>
                <span class="menu-icon"></span>
            </button>
        </header>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="footer">
            <div class="footer-content">
                <div class="social-media">
                    <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="social-icon"><i class="fab fa-youtube"></i></a>
                </div>
                <p>&copy; 2026 Ankara Turnuvası</p>
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>