@model IEnumerable<FootballWEB.Models.Team>

<section class="players-section">

    <h2>Turnuva Takımları</h2>

    <!-- TAKIM EKLE -->
    <div class="add-team-section">

        <form asp-controller="Home"
              asp-action="AddTeam"
              method="post">

            <input type="text"
                   name="teamName"
                   placeholder="Takım Adı"
                   required />

            <button type="submit">
                Takım Ekle
            </button>

        </form>

    </div>

    <div class="players-container">

        @foreach (var item in Model)
        {
            <div class="player-card">

                <div class="player-card-logo-container">

                    <img src="~/images/Teams/@(item.TeamName.Replace(" ", "")).png"
                         onerror="this.onerror=null; this.src='/images/logo.png';"
                         alt="@item.TeamName">

                </div>

                <div class="player-info-overlay">

                    <div class="player-header">

                        <div class="player-details">

                            <h2>@item.TeamName</h2>

                            <h3>
                                Kuruluş: @item.FoundedYear
                            </h3>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</section>